rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* ── users/{uid} ─────────────────────────────
       Any signed-in user can look a profile up (needed for the
       phone/username search on chats.html, profile.html, setup.html),
       but only the owner can write their own document. */
    match /users/{uid} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      /* users/{uid}/notifications/{notifId} — only the owner can
         read, mark-as-read, or delete their own notifications. Cloud
         Functions write these with the Admin SDK, which bypasses
         rules entirely, so no separate "create" case is needed here. */
      match /notifications/{notifId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;

        // The owner can always create their own notification docs.
        allow create: if signedIn() && request.auth.uid == uid;

        // A caller can write a missed-call notice into the *callee's*
        // subcollection (there is no Cloud Function trigger for calls,
        // so this is the only delivery path). Locked down so a client
        // can only create 'call' notifications and can't spoof the
        // sender identity or fabricate other notification types
        // (message/request/system stay server-only, written by Cloud
        // Functions via the Admin SDK, which bypasses rules).
        allow create: if signedIn() &&
          request.auth.uid != uid &&
          request.resource.data.type == 'call' &&
          request.resource.data.fromUid == request.auth.uid;
      }

      /* users/{uid}/friends/{friendId} — a user can manage their own
         friends list, and can also write the *reciprocal* entry in
         someone else's friends list, but only the doc that represents
         themself (friendId == their own uid). This is what lets
         accepting a friend request add both sides of the friendship. */
      match /friends/{friendId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() &&
          (request.auth.uid == uid || request.auth.uid == friendId);
      }
    }

    /* ── chats/{chatId} ──────────────────────────
       Only participants can read/write a chat, and a chat can only be
       created if the creator includes themself as a participant. */
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    /* ── friend_requests/{requestId} ─────────────
       The sender can create; either side can read; only the
       recipient can update (accept/reject). */
    match /friend_requests/{requestId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromUid;
      allow update: if signedIn() && request.auth.uid == resource.data.toUid;
    }

    /* ── fcmTokens/{uid} ──────────────────────────
       Only the owner can write their push token from the client.
       Cloud Functions read/delete it with the Admin SDK. */
    match /fcmTokens/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
